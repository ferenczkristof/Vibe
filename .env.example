# Suno Official MCP Endpoint
SUNO_MCP_URL=https://api.suno.com/mcp

# Optional Bearer / OAuth access token for https://api.suno.com/mcp
# Leave blank to use automatic fallback/synth mode or pass token in the UI Settings dialog
SUNO_MCP_TOKEN=

# Image Generation Provider (Pollinations.ai is free and requires no API key)
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt

# Set MOCK_MODE=true to allow instant procedural synth music generation when Suno MCP OAuth is not connected
MOCK_MODE=true
